---
import CtaSection from "../components/CtaSection.astro";
import PageHero from "../components/PageHero.astro";
import Picture from "../components/Picture.astro";
import { projectsPage } from "../data/projects";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout page="projects" active="projects.html">
  <PageHero {...projectsPage.hero} variant="projects" />

  <section class="section section--dark">
    <div class="container">
      <div class="filter-bar reveal">
        {projectsPage.filters.map((item, i) => <button class={i === 0 ? "filter-btn active" : "filter-btn"} data-filter={item.filter}>{item.label}</button>)}
      </div>

      <div class="gallery-grid reveal">
        {projectsPage.items.map((item) => (
          <div class={`gallery-item gallery-item--${item.layout}`} data-category={item.category}>
            <Picture class={`gallery-item__photo obj-y-${item.focus ?? 50}`} use={item} />
            <div class="gallery-item__hover">
              <div class="gallery-item__hover-type">{item.type}</div>
              <div class="gallery-item__hover-title">{item.title}</div>
              <i class="fas fa-expand-alt" aria-hidden="true"></i>
            </div>
          </div>
        ))}
      </div>

      <p class="reveal gallery-note">
        {projectsPage.note.before}<a href={projectsPage.note.href} class="gallery-note__link">{projectsPage.note.linkLabel}</a>{projectsPage.note.after}
      </p>
    </div>
  </section>

  <CtaSection {...projectsPage.cta} />
</BaseLayout>
