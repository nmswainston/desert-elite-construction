---
import { nav, navButton } from "../data/nav";
import { site } from "../data/site";

interface Props {
  /** The menu link to highlight: the page's file name, such as "about.html". */
  active?: string;
}
const { active } = Astro.props;
const instagramIcon = `<svg class="nav__social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>`;
---
<header class="site-header">
  <nav class="nav">
    <div class="nav__inner">
      <a href="index.html" class="nav__logo">
        <img src="images/logo-white.svg" alt={site.name} class="nav__logo-img" width="384" height="144" />
      </a>
      <ul class="nav__links">
        {nav.map((link) => <li><a href={link.href} class={link.href === active ? "nav__link active" : "nav__link"}>{link.label}</a></li>)}
        <li><a href={site.instagram.href} class="nav__link nav__social" target="_blank" rel="noopener" aria-label={site.instagram.label} set:html={instagramIcon}></a></li>
      </ul>
      <a href={navButton.href} class="btn btn-primary nav__cta">{navButton.label}</a>
      <button class="nav__burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
  <div class="nav__mobile" id="mobileMenu" inert>
    {nav.map((link) => <a href={link.href} class="nav__mobile-link">{link.label}</a>)}
    <a href={site.instagram.href} class="nav__mobile-link nav__mobile-social" target="_blank" rel="noopener"><Fragment set:html={instagramIcon} /> Instagram</a>
    <a href={navButton.href} class="btn btn-primary nav__mobile-cta">{navButton.label}</a>
  </div>
</header>
